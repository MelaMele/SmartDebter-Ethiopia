{
    "name": "melamele/smart-debter",
    "type": "project",
    "description": "SmartDebter - Digital Communication Book for Ethiopian Schools",
    "keywords": ["laravel", "school", "communication", "ethiopia"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
